# Password for the "Web dev edit" mode. Set this in Vercel → Project → Settings →
# Environment Variables. Never commit the real value.
ADMIN_PASSWORD=

# Secret used to sign the edit-mode session cookie. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Provisioned automatically by the Upstash for Redis marketplace integration.
# If these are absent the data layer falls back to a local JSON file (.data/store.json),
# which is fine for local dev but does NOT persist on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Set to "1" to allow POST /api/seed. Leave unset in production.
ALLOW_SEED=

# Keeps `vercel dev` on the local file store even if the CLI injects the production
# database credentials. Set this in your local .env only — never on Vercel.
ADVATAR_LOCAL_STORE=1
